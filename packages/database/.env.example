# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA

# Local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/publicadis?schema=public"

# Production (example with connection pooling)
# DATABASE_URL="postgresql://user:password@host:5432/publicadis?schema=public&connection_limit=5&pool_timeout=10"

# For Neon, Supabase, Railway, etc:
# DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/publicadis?sslmode=require"

# For local Docker PostgreSQL:
# docker run --name publicadis-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=publicadis -p 5432:5432 -d postgres:15
