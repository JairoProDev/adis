{
  "name": "publicadis",
  "version": "0.1.0",
  "private": true,
  "description": "Publicadis - La infraestructura de clasificados de próxima generación para LATAM",
  "repository": {
    "type": "git",
    "url": "https://github.com/JairoProDev/adis.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "./node_modules/.bin/turbo run dev",
    "build": "./node_modules/.bin/turbo run build",
    "test": "./node_modules/.bin/turbo run test",
    "lint": "./node_modules/.bin/turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "./node_modules/.bin/turbo run clean && rm -rf node_modules",
    "typecheck": "./node_modules/.bin/turbo run typecheck",
    "db:generate": "npm run db:generate --workspace=@publicadis/database",
    "db:push": "npm run db:push --workspace=@publicadis/database",
    "db:migrate": "npm run db:migrate --workspace=@publicadis/database",
    "db:seed": "npm run db:seed --workspace=@publicadis/database",
    "db:studio": "npm run db:studio --workspace=@publicadis/database",
    "db:reset": "npm run db:reset --workspace=@publicadis/database"
  },
  "devDependencies": {
    "@turbo/gen": "^2.3.3",
    "eslint": "^8.57.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
